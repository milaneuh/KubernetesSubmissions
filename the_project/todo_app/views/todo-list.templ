package views

templ TodoList(todos []string) {
	<section style="margin-bottom: 2rem;">
		<form
			id="todo-form"
			hx-post="/new-todo"
			hx-target="#todo-list"
			hx-swap="innerHTML"
			hx-on::after-request="this.reset()"
			style="display: flex; gap: 0.5rem; width: 100%;"
		>
			<input
				type="text"
				name="todo-input"
				placeholder="Enter a new todo (max 140 characters)"
				max="140"
				style="flex-grow: 1; margin: 0;"
			/>
			<button type="submit" style="margin: 0;">Send</button>
		</form>
	</section>
	<section >
		<h2>My Tasks</h2>
		<ul id="todo-list" style="list-style: none; padding: 0; display: flex; flex-direction: column; gap: 0.5rem;">
			@Todo(todos)
		</ul>
	</section>
}
